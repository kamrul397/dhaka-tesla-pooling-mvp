# Dhaka Tesla Pool - Environment Configuration Example
# (Never commit actual secrets or credentials to git)

# API Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL inside Docker or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dhaka_tesla_pool?schema=public"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
